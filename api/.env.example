# --- Runtime DB (mysql2 pool in src/infra/db.ts) ---
# HOST accepts "host" or "host:port". Local dev with npm run db:up:
#   CORDEL_FITNESS_DB_HOST=localhost:3306
#   CORDEL_FITNESS_DB_USER=root
#   CORDEL_FITNESS_DB_PASSWORD=fitness
#   CORDEL_FITNESS_DB_NAME=fitness
CORDEL_FITNESS_DB_HOST=host:3306
CORDEL_FITNESS_DB_USER=user
CORDEL_FITNESS_DB_PASSWORD=password
CORDEL_FITNESS_DB_NAME=fitness

# --- Migrations only (knexfile.cjs, one-shot podman run in deploy) ---
# Locally, points at the same DB as above. In prod, injected from the
# DATABASE_URL_MIGRATIONS GitHub secret (DDL-privileged fitness_deploy user).
DATABASE_URL=mysql://root:fitness@localhost:3306/fitness

PORT=3000

# --- Locales (#643) — both optional, defaults shown ---
# Languages the API will resolve DB-stored translated content in. Must match the
# admin/member apps' next-intl locales; entries that aren't well-formed locale
# tags are ignored.
# SUPPORTED_LOCALES=en,es,ca
# The language base columns are written in, and the fallback when a locale has
# no translation row. Must be one of SUPPORTED_LOCALES.
# DEFAULT_LOCALE=en
CORDEL_FITNESS_ADMIN_URL=http://localhost:8081
CORDEL_FITNESS_MEMBERS_URL=http://localhost:8082

# --- Website self-registration (#599) — all optional, defaults shown ---
# Reverse-proxy hops in front of the API (nginx = 1). 0 when nothing proxies it.
# TRUST_PROXY_HOPS=1
# PUBLIC_REGISTRATION_IP_LIMIT_PER_HOUR=60
# PUBLIC_REGISTRATION_GYM_LIMIT_PER_DAY=200
# Public origin of this API, shown on System → Website Integration.
# Falls back to the origin of PAYMENT_NOTIFICATION_URL.
# API_PUBLIC_URL=http://localhost:3000

# --- MONEI (required to create payment requests; lazy-loaded on first charge) ---
PAYMENT_PROVIDER=monei
PAYMENT_PAGE_URL=http://localhost:8083
PAYMENT_OK_URL=http://localhost:8082/en/payment/success
PAYMENT_KO_URL=http://localhost:8082/en/payment/error
PAYMENT_NOTIFICATION_URL=http://localhost:3000/webhooks/payment
MONEI_API_KEY=
MONEI_WEBHOOK_SECRET=
# Only needed when MONEI_API_KEY is a MONEI Connect *partner* (master) key: merchant
# operations are sent with a MONEI-Account-ID header naming the sub-account, or they 401.
# MONEI_ACCOUNT_ID=
# Informational only — reported by GET /platform/payment-providers/deployment so a screen
# can say which provider environment this API is pointed at. Never used to pick a key.
# PAYMENT_ENV=test
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the Clerk webhook (Dashboard → Webhooks → your endpoint).
# Backstops team-invite activation on the `user.created` event.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Used only for the seed script
SEED_USER_ID=

# --- Internal job runners (X-Internal-Secret header) ---
# Shared secret for POST /billing/run and /billing/cleanup, fired nightly by
# .github/workflows/billing-run.yml. Unset = every call is 401.
BILLING_INTERNAL_SECRET=
# #647 stage 4: shared secret for POST /recurring-bookings/run, fired nightly by
# .github/workflows/recurring-booking-run.yml to maintain the rolling 2-month
# Personal Training booking window. Separate from the billing secret on purpose —
# the two jobs have different blast radii. Unset = every call is 401.
RECURRING_BOOKINGS_INTERNAL_SECRET=
# #783: per-IP budget of failed-secret (401) calls across the three internal run
# routes above, so the secret cannot be guessed at the global 500/15 min limit —
# there is no nginx allowlist in front of them. A call with the right secret
# never spends it. Optional; values below 1 are ignored. Defaults shown.
# INTERNAL_RUN_RATE_LIMIT_MAX=10
# INTERNAL_RUN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Payment request expiry (#789) — optional, default shown ---
# How long POST /billing/cleanup leaves a payment request `pending` once its
# checkout page has been *opened*, in hours. The 10-minute `page_token` TTL
# cannot be this deadline: the token is consumed when the page loads, and the
# member then spends minutes in the Card Input and a 3DS redirect, after which
# Monei may retry its webhook. Expiring the row inside that window made the
# completed webhook skip a payment that had actually been made. Values below 1
# are ignored so a typo cannot reintroduce that. A request whose page was never
# opened still expires with its token, whatever this says.
# PAYMENT_REQUEST_ABANDONED_HOURS=24

# --- Nightly run freshness (#782) — optional, default shown ---
# GET /health/runs reports a run log as `stale: true` when its latest completed
# run finished longer ago than this many hours (or never completed at all).
# A Grafana Cloud synthetic check alerts on it. Whole hours; values below 1
# are ignored.
# RUN_FRESHNESS_THRESHOLD_HOURS=26

# --- Cloudflare R2 (#417, optional — image upload / gym storage) ---
# Platform-wide, S3-compatible object storage. One shared bucket, folder-scoped
# per gym (see api/src/infra/storage.ts). Leave unset to disable storage
# features; "Initialize Cloudflare Bucket" and uploads then fail gracefully.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# The origin browsers read the bucket from: its r2.dev Public Development URL or
# a custom domain connected to it, with no trailing slash and no bucket name
# (it serves the bucket root). CLOUDFLARE_R2_ENDPOINT above is the S3 API the
# API uploads through, and it answers a browser's GET with 400 Authorization,
# so stored image URLs built on it render broken. Unset keeps that old
# composition. After setting it, run `npm run storage:rewrite-urls` once.
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Exercise videos (#719 part 2, #717) — optional, default shown ---
# Largest MP4 POST /exercises/:id/video and POST /platform/exercises/:id/video
# accept, in megabytes — one cap for a gym's and the library's. The upload is
# buffered in the API process, so this is what bounds that memory; values above
# 200 are clamped. Keep the admin app's NEXT_PUBLIC_EXERCISE_VIDEO_MAX_MB in
# step, so the picker refuses an oversized file before uploading it.
# EXERCISE_VIDEO_MAX_MB=50
