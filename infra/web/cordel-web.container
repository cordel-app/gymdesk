# Reference Quadlet — Oscar's live unit on corfront.
# Path: /home/podman/.config/containers/systemd/cordel-web.container
# deploy-web.yml only pulls the image and restarts this unit: the site has no
# runtime environment, so the whole unit is Oscar's (ports, network, restart).
# Traefik: cordel.tech (and www.cordel.tech) → localhost:8084.

[Unit]
Description=Cordel web (cordel.tech)
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/cordel-app/cordel-web:latest
ContainerName=cordel-web
LogDriver=journald
PublishPort=8084:80

[Service]
Restart=always

[Install]
WantedBy=default.target
