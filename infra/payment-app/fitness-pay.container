# Reference Quadlet — Oscar's live unit on corfront.
# Path: /home/podman/.config/containers/systemd/fitness-pay.container
# CI never writes this file. Workflows only podman pull + systemctl restart.
# Traefik: pay.vdicube.com → localhost:8083.
# PCI: do not log query strings on this host (page_token lives in ?token=).
#      The container's own access log drops them since #1083 (log_format
#      pay_no_query in apps/payment/templates/default.conf.template); Traefik's
#      own log is still Oscar's to configure.

[Unit]
Description=Cordel Fitness Pay
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/cordel-app/fitness-pay:latest
ContainerName=fitness-pay
LogDriver=journald
PublishPort=8083:80
# #1083 — two origins, because Monei's webhook is relayed by this container.
#   PUBLIC:   what the browser-facing proxies (/payment-page/, /themes/) call.
#   INTERNAL: what POST /webhooks/payment is handed to, so the provider no
#             longer posts to the API's host itself.
# Both may be the API's public hostname (#1087): the host stays public by name
# and corback allows only corfront's address through, so this container reaches
# it as an allowed caller. No trailing slash on either. On pro these are the pro
# API's addresses.
Environment=CORDEL_FITNESS_API_PUBLIC_URL="https://api.vdicube.com"
Environment=CORDEL_FITNESS_API_INTERNAL_URL="https://api.vdicube.com"

[Service]
Restart=always

[Install]
WantedBy=default.target
