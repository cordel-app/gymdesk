<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  #1074 (mobile app WP3) — the two entitlements the shell needs.

	  `keychain-access-groups` is the 2026-10-04 spike's own finding
	  (`docs/mobile-app.md` §3): without it a simulator build fails Google
	  Sign-In with `keychain error`, because an ad-hoc signature gives the app no
	  keychain group of its own. It is written as the build settings rather than
	  as a literal, so it follows the app profile's Bundle ID (design rule 1) —
	  a second app profile needs no edit here.

	  `aps-environment` is `development`, which is what a simulator, a debug
	  build and TestFlight's development pushes use. A store build needs
	  `production`; Xcode rewrites it when exporting with a distribution
	  profile, and `docs/mobile-runbook.md` carries the check.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  #1076 (mobile app WP4) — the domain whose links this build may open as
	  universal links. `applinks:<host>` is the host of the app profile's
	  `serverUrl` (`associatedDomains()`), written by `npm run profile:apply`
	  rather than ticked in Xcode: *Associated Domains* added in the UI would
	  carry this gym's host into every other profile's build.

	  The other half of the grant is the file that host serves —
	  `/.well-known/apple-app-site-association`, from `apps/member`. Until the
	  deployment configures `MOBILE_APP_ASSOCIATIONS` with the Apple Team ID,
	  that file is a 404 and iOS falls back to opening the link in Safari, which
	  still completes the invitation (`docs/mobile-runbook.md` §2).
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:members.vdicube.com</string>
	</array>
</dict>
</plist>
