# #1074 (mobile app WP3) — the shell's build-time configuration.
#
# Every value here overrides the field of the same name in the app profile
# (`profiles/<MOBILE_APP_PROFILE>.json`), one field at a time, so a build can be
# pointed at a staging URL without editing a profile and a stage-2 per-gym app
# needs no environment at all. `docs/mobile-app.md` design rule 1: no app
# identity is hard-coded.
#
# Copy to `.env` for local use; `cap` reads the process environment, so CI sets
# these as job env instead.

# Which profile to build. Default: cordel-fitness (the stage-1 generic app).
MOBILE_APP_PROFILE=cordel-fitness

# The deployed Members App the shell loads, and the hosts it may navigate to
# (comma- or space-separated). The server URL's own host is always allowed.
# MOBILE_SERVER_URL=https://members.vdicube.com
# MOBILE_ALLOW_NAVIGATION=members.vdicube.com

# App identity. Changing these is a different app: a new Bundle ID / package
# needs its own Google clients, Firebase app, signing identity and store entry.
# MOBILE_APP_ID=com.cordel.fitness
# MOBILE_APP_NAME=Cordel Fitness
# MOBILE_CUSTOM_URL_SCHEME=com.cordel.fitness

# Google native sign-in. The iOS client is bound to the Bundle ID; the **web**
# client is the audience Clerk verifies the ID token against (the 2026-10-04
# spike's one finding). With neither set the shell registers no Google URL
# scheme and the Members App renders no native Google button (WP2).
# MOBILE_GOOGLE_IOS_CLIENT_ID=
# MOBILE_GOOGLE_WEB_CLIENT_ID=
