CORDEL_FITNESS_API_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/en

# Native shell (#1073, mobile app WP2). Both are OAuth client ids from the same
# Google Cloud project: the iOS one identifies the app, the web one is the
# audience Clerk verifies the ID token against, so iOS is initialised with both.
# Leave them unset and the native Google button is simply not rendered.
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App Links / universal links (#1076, mobile app WP4). One JSON object keyed by
# app id — the same shape as the API's FCM_SERVICE_ACCOUNTS, so a stage-2 per-gym
# app is a new key rather than a code change — naming the credentials each app is
# published under: the Apple Developer Team ID and the SHA-256 fingerprints of
# the Android signing certificates (upload *and* Play App Signing). Either half
# may be omitted. The value may also be base64 of the same JSON, for a deployment
# that carries its environment as inline systemd `Environment=` lines.
# Unset, /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# answer 404 and a tapped invitation link simply opens in the browser.
MOBILE_APP_ASSOCIATIONS=
