CORDEL_FITNESS_API_URL=http://localhost:3000
# #1086: how long /api/internal waits for the API, in milliseconds. The default
# (660000) sits above the longest --max-time in .github/workflows/, so `curl` is
# always the one that gives up first and a long /recurring-bookings/run is never
# reported as failed after the API completed it.
# INTERNAL_RUN_RELAY_TIMEOUT_MS=660000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/en
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/en
# Largest exercise video the picker accepts, in megabytes (#719 part 2, #717).
# Mirrors the API's EXERCISE_VIDEO_MAX_MB — the server is the authority.
# NEXT_PUBLIC_EXERCISE_VIDEO_MAX_MB=50
TENANT=
